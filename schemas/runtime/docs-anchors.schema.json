{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archcontext.dev/schemas/runtime/docs-anchors.schema.json",
  "title": "DocsAnchorsReportV1",
  "description": "Read-only result of `archctx docs anchors`: stale citations in human-owned module document regions and node prose. A signal, not a gate.",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "profile",
    "codeGraph",
    "summary",
    "nodes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "archcontext.docs-anchors/v1"
    },
    "profile": {
      "enum": [
        "default",
        "repo-harness/v1"
      ]
    },
    "codeGraph": {
      "oneOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "availability"
          ],
          "properties": {
            "availability": {
              "const": "ready"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "availability",
            "reasonCode"
          ],
          "properties": {
            "availability": {
              "const": "unavailable"
            },
            "reasonCode": {
              "enum": [
                "index-missing",
                "index-open-failed"
              ]
            }
          }
        }
      ]
    },
    "summary": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "nodes",
        "documents",
        "citations",
        "findings",
        "unchecked",
        "byKind"
      ],
      "properties": {
        "nodes": {
          "$ref": "#/$defs/count"
        },
        "documents": {
          "$ref": "#/$defs/count"
        },
        "citations": {
          "$ref": "#/$defs/count"
        },
        "findings": {
          "$ref": "#/$defs/count"
        },
        "unchecked": {
          "$ref": "#/$defs/count"
        },
        "byKind": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "line-moved",
            "line-out-of-range",
            "missing-path",
            "missing-symbol",
            "unknown-selector"
          ],
          "properties": {
            "line-moved": {
              "$ref": "#/$defs/count"
            },
            "line-out-of-range": {
              "$ref": "#/$defs/count"
            },
            "missing-path": {
              "$ref": "#/$defs/count"
            },
            "missing-symbol": {
              "$ref": "#/$defs/count"
            },
            "unknown-selector": {
              "$ref": "#/$defs/count"
            }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nodeId",
          "citationCount",
          "findings",
          "unchecked"
        ],
        "properties": {
          "nodeId": {
            "minLength": 1,
            "type": "string"
          },
          "documentPath": {
            "$ref": "#/$defs/repoPath"
          },
          "citationCount": {
            "minimum": 1,
            "type": "integer"
          },
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/finding"
            }
          },
          "unchecked": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/unchecked"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "count": {
      "minimum": 0,
      "type": "integer"
    },
    "line": {
      "minimum": 1,
      "type": "integer"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "/$"
          },
          {
            "pattern": "//"
          },
          {
            "pattern": "\\\\"
          },
          {
            "pattern": "^[A-Za-z]:"
          },
          {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          },
          {
            "pattern": "(^|/)\\.\\.?(/|$)"
          }
        ]
      }
    },
    "origin": {
      "oneOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "path",
            "line"
          ],
          "properties": {
            "kind": {
              "const": "document"
            },
            "path": {
              "$ref": "#/$defs/repoPath"
            },
            "line": {
              "$ref": "#/$defs/line"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "node-summary"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "index"
          ],
          "properties": {
            "kind": {
              "const": "node-responsibility"
            },
            "index": {
              "minimum": 0,
              "type": "integer"
            }
          }
        }
      ]
    },
    "citation": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "minLength": 1,
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "resolvedPath": {
          "$ref": "#/$defs/repoPath"
        },
        "line": {
          "$ref": "#/$defs/line"
        },
        "endLine": {
          "$ref": "#/$defs/line"
        },
        "symbol": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "finding": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "origin",
        "citation"
      ],
      "properties": {
        "kind": {
          "enum": [
            "line-moved",
            "line-out-of-range",
            "missing-path",
            "missing-symbol",
            "unknown-selector"
          ]
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "citation": {
          "$ref": "#/$defs/citation"
        },
        "lineCount": {
          "$ref": "#/$defs/count"
        },
        "currentLines": {
          "minItems": 1,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "$ref": "#/$defs/line"
          }
        }
      }
    },
    "unchecked": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "reasonCode",
        "origin",
        "citation"
      ],
      "properties": {
        "reasonCode": {
          "enum": [
            "codegraph-unavailable",
            "language-unsupported",
            "path-ambiguous"
          ]
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "citation": {
          "$ref": "#/$defs/citation"
        }
      }
    }
  }
}
