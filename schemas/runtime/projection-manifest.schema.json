{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archcontext.dev/schemas/runtime/projection-manifest.schema.json",
  "title": "ArchitectureDocsProjectionManifestV4",
  "description": "The committed docs/architecture/.projection-manifest.json the architecture documentation projection writes (#264, #327, ADR-0056). Version v4 records no digest of raw source: a target row holds only what the render produced, and its outputDigest is the target's freshness identity, so a source edit that changes no output, no proof evidence and no header line leaves the file byte-identical. Header lines change only on a protocol upgrade, semanticBaseline.modelDigest is the one Git-visible anchor, and every other value belongs to one capability or one target row, so changes to different capabilities rewrite disjoint lines. A v1, v2 or v3 manifest is not valid against this schema and is refused with projection-manifest-upgrade-required. Sorted/unique orders and the byte layout are enforced by architectureDocsProjectionManifestIssues and serializeArchitectureDocsProjectionManifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rendererVersion",
    "profile",
    "layoutVersion",
    "generatedFrom",
    "semanticBaseline",
    "targets"
  ],
  "properties": {
    "schemaVersion": {
      "const": "archcontext.architecture-docs-projection-manifest/v4"
    },
    "rendererVersion": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "default",
        "repo-harness/v1"
      ]
    },
    "layoutVersion": {
      "const": "archcontext.docs-layout/v1"
    },
    "generatedFrom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codeGraphPackage",
        "codeGraphVersion"
      ],
      "description": "Reproducible CodeGraph identity only: package name and version. The binary digest, index status and evidence digests are machine-specific runtime facts and never enter the committed manifest (#266, #277).",
      "properties": {
        "codeGraphPackage": {
          "type": "string",
          "minLength": 1
        },
        "codeGraphVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "semanticBaseline": {
      "$ref": "#/$defs/semanticBaseline"
    },
    "targets": {
      "type": "object",
      "description": "Target rows keyed by targetId.",
      "additionalProperties": {
        "$ref": "#/$defs/target"
      }
    },
    "minimumRendererVersion": {
      "type": "string",
      "pattern": "^archcontext\\.docs-renderer/v[1-9][0-9]*$",
      "description": "Optional minimum engine renderer; an older engine refuses rendering and writes."
    },
    "minimumProtocolVersion": {
      "type": "string",
      "pattern": "^archcontext\\.projection-request/v[1-9][0-9]*$",
      "description": "Optional minimum projection request protocol supported by the engine."
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "semanticBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelDigest",
        "capabilities"
      ],
      "properties": {
        "modelDigest": {
          "$ref": "#/$defs/digest",
          "description": "The one Git-visible anchor: the digest of the model this baseline was compiled from. Concurrent model changes conflict on this line, as they should."
        },
        "capabilities": {
          "type": "array",
          "description": "Sorted and unique by capabilityId.",
          "items": {
            "$ref": "#/$defs/capabilityState"
          }
        }
      }
    },
    "capabilityState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityId",
        "memberNodeIds",
        "semanticFingerprint",
        "flowProofFingerprint",
        "proofStatus",
        "facets",
        "selectorEvidenceDigest"
      ],
      "properties": {
        "capabilityId": {
          "type": "string",
          "minLength": 1
        },
        "memberNodeIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "semanticFingerprint": {
          "$ref": "#/$defs/digest"
        },
        "flowProofFingerprint": {
          "$ref": "#/$defs/digest"
        },
        "proofStatus": {
          "$ref": "#/$defs/proofStatus"
        },
        "facets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "constraints",
            "entrypoints",
            "interfaces",
            "lifecycle",
            "names",
            "ownership",
            "placement",
            "relations",
            "responsibilities",
            "riskBoundaries"
          ],
          "properties": {
            "constraints": {
              "$ref": "#/$defs/digest"
            },
            "entrypoints": {
              "$ref": "#/$defs/digest"
            },
            "interfaces": {
              "$ref": "#/$defs/digest"
            },
            "lifecycle": {
              "$ref": "#/$defs/digest"
            },
            "names": {
              "$ref": "#/$defs/digest"
            },
            "ownership": {
              "$ref": "#/$defs/digest"
            },
            "placement": {
              "$ref": "#/$defs/digest"
            },
            "relations": {
              "$ref": "#/$defs/digest"
            },
            "responsibilities": {
              "$ref": "#/$defs/digest"
            },
            "riskBoundaries": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "selectorEvidenceDigest": {
          "$ref": "#/$defs/digest",
          "description": "Digest of the proof-relevant selector evidence for the selectors this capability's flows cite."
        }
      }
    },
    "proofStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p1",
        "p2"
      ],
      "properties": {
        "p1": {
          "enum": [
            "proven",
            "unprovable"
          ]
        },
        "p2": {
          "enum": [
            "not-applicable",
            "proven",
            "unprovable"
          ]
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "scope",
        "path",
        "ownership",
        "format",
        "outputDigest"
      ],
      "description": "One target row, keyed by its targetId. The key and the manifest header carry the targetId and the renderer version, so the row repeats neither. An agent-context row owns one node's region in a contract file, so it is mixed, markdown and entity-scoped with an id, and several agent-context rows may share a path when their scope ids differ.",
      "if": {
        "properties": { "type": { "const": "agent-context" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "ownership": { "const": "mixed" },
          "format": { "const": "markdown" },
          "scope": {
            "properties": { "kind": { "const": "entity" }, "id": { "type": "string", "minLength": 1 } },
            "required": ["kind", "id"]
          }
        }
      },
      "properties": {
        "type": {
          "enum": [
            "architecture-index",
            "entity-summary",
            "relation-summary",
            "decision-index",
            "diagram-mermaid",
            "diagram-structurizr",
            "diagram-likec4",
            "diagram-runtime-topology",
            "runtime-topology-summary",
            "architecture-history",
            "agent-context"
          ]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "repository",
                "entity",
                "relation",
                "decision",
                "diagram"
              ]
            },
            "id": {
              "type": "string"
            },
            "entityKind": {
              "type": "string"
            }
          }
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "not": {
            "anyOf": [
              {
                "pattern": "^/"
              },
              {
                "pattern": "\\\\"
              },
              {
                "pattern": "(^|/)\\.\\.(/|$)"
              }
            ]
          }
        },
        "ownership": {
          "enum": [
            "generated",
            "mixed"
          ]
        },
        "format": {
          "enum": [
            "markdown",
            "mermaid",
            "structurizr-json",
            "likec4"
          ]
        },
        "outputDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
