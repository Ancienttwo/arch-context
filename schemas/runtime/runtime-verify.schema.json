{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archcontext.dev/schemas/runtime/runtime-verify.schema.json",
  "title": "RuntimeVerifyV1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "base",
    "baseSha",
    "headSha",
    "checks"
  ],
  "properties": {
    "schemaVersion": {
      "const": "archcontext.runtime-verify/v1"
    },
    "base": {
      "minLength": 1,
      "type": "string"
    },
    "baseSha": {
      "$ref": "#/$defs/oid"
    },
    "headSha": {
      "$ref": "#/$defs/oid"
    },
    "checks": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "validate",
        "flows",
        "state-machines",
        "constraints",
        "docs",
        "projection",
        "debt"
      ],
      "properties": {
        "validate": {
          "oneOf": [
            {
              "$ref": "#/$defs/failed"
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/passed"
                },
                {
                  "properties": {
                    "data": {
                      "$ref": "#/$defs/validation"
                    }
                  }
                }
              ]
            }
          ]
        },
        "flows": {
          "oneOf": [
            {
              "$ref": "#/$defs/failed"
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/passed"
                },
                {
                  "properties": {
                    "data": {
                      "$ref": "flow-selector-check.schema.json"
                    }
                  }
                }
              ]
            }
          ]
        },
        "state-machines": {
          "oneOf": [
            {
              "$ref": "#/$defs/failed"
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/passed"
                },
                {
                  "properties": {
                    "data": {
                      "$ref": "state-machine-check.schema.json"
                    }
                  }
                }
              ]
            }
          ]
        },
        "constraints": {
          "oneOf": [
            {
              "$ref": "#/$defs/failed"
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/passed"
                },
                {
                  "properties": {
                    "data": {
                      "$ref": "dependency-constraint-evaluation.schema.json"
                    }
                  }
                }
              ]
            }
          ]
        },
        "docs": {
          "oneOf": [
            {
              "$ref": "#/$defs/failed"
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/passed"
                },
                {
                  "properties": {
                    "data": {
                      "$ref": "docs-anchors.schema.json"
                    }
                  }
                }
              ]
            }
          ]
        },
        "projection": {
          "oneOf": [
            {
              "$ref": "#/$defs/failed"
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/passed"
                },
                {
                  "properties": {
                    "data": {
                      "$ref": "projection-pr-verification.schema.json"
                    }
                  }
                }
              ]
            }
          ]
        },
        "debt": {
          "oneOf": [
            {
              "$ref": "#/$defs/failed"
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/passed"
                },
                {
                  "properties": {
                    "data": {
                      "$ref": "https://archctx.repoharness.com/schemas/runtime/architecture-debt.schema.json"
                    }
                  }
                }
              ]
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "oid": {
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
      "type": "string"
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "passed": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "ok",
        "data"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "data": {}
      }
    },
    "failed": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "ok",
        "error"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "code",
            "message",
            "severity",
            "retryable",
            "action"
          ],
          "properties": {
            "code": {
              "pattern": "^AC_[A-Z_]+$",
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "severity": {
              "enum": [
                "notice",
                "warning",
                "error",
                "critical"
              ]
            },
            "retryable": {
              "type": "boolean"
            },
            "action": {
              "type": "string"
            },
            "reasonCode": {
              "type": "string"
            },
            "details": {
              "type": "object"
            }
          }
        }
      }
    },
    "validation": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "valid",
        "errors",
        "modelDigest"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "errors": {
          "$ref": "#/$defs/strings"
        },
        "modelDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "referenceErrors": {
          "$ref": "#/$defs/strings"
        },
        "layerOrderErrors": {
          "$ref": "#/$defs/strings"
        },
        "allowedTargetErrors": {
          "$ref": "#/$defs/strings"
        },
        "warnings": {
          "$ref": "#/$defs/strings"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "path",
              "code",
              "error"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "code": {
                "enum": [
                  "missing-file",
                  "schema-version-missing",
                  "node-schema-invalid"
                ]
              },
              "error": {
                "type": "string"
              }
            }
          }
        },
        "nodeSchemaErrors": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "path",
              "error"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "error": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
