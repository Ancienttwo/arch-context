{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archcontext.dev/schemas/runtime/flow-selector-check.schema.json",
  "title": "ArchitectureFlowSelectorCheckV1",
  "description": "The data of `archctx flows check`: the P2 flow proof of every capability that declares a flow, and the proof status of every declared entrypoint-to-sink selector, computed without rendering. Consumers detect it through the flow-selector-check-v1 capability.",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "ok",
    "codeGraph",
    "summary",
    "selectors",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": "archcontext.flow-selector-check/v1"
    },
    "ok": {
      "description": "True when no capability that declares a flow has an unprovable P2 proof.",
      "type": "boolean"
    },
    "codeGraph": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "availability",
        "version"
      ],
      "properties": {
        "availability": {
          "enum": [
            "ready",
            "unavailable"
          ]
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "summary": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "selectors",
        "proven",
        "unproven",
        "usedUnproven"
      ],
      "properties": {
        "selectors": {
          "minimum": 0,
          "type": "integer"
        },
        "proven": {
          "minimum": 0,
          "type": "integer"
        },
        "unproven": {
          "minimum": 0,
          "type": "integer"
        },
        "usedUnproven": {
          "minimum": 0,
          "description": "Unproven selectors that a required-flow step names.",
          "type": "integer"
        }
      }
    },
    "selectors": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nodeId",
          "entrypointId",
          "sourcePath",
          "sourceSymbol",
          "sinkId",
          "sinkPath",
          "sinkSymbol",
          "status",
          "callSites",
          "referenceSites",
          "rejectedBuiltinCallSites",
          "flowSteps"
        ],
        "properties": {
          "nodeId": {
            "minLength": 1,
            "type": "string"
          },
          "entrypointId": {
            "minLength": 1,
            "type": "string"
          },
          "sourcePath": {
            "minLength": 1,
            "type": "string"
          },
          "sourceSymbol": {
            "minLength": 1,
            "type": "string"
          },
          "sinkId": {
            "minLength": 1,
            "type": "string"
          },
          "sinkPath": {
            "minLength": 1,
            "type": "string"
          },
          "sinkSymbol": {
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "description": "Only proven binds a flow step.",
            "enum": [
              "ambiguous-symbol",
              "evidence-missing",
              "evidence-truncated",
              "false-builtin-call",
              "no-direct-call",
              "only-references",
              "proven"
            ]
          },
          "callSites": {
            "$ref": "#/$defs/sites"
          },
          "referenceSites": {
            "$ref": "#/$defs/sites"
          },
          "rejectedBuiltinCallSites": {
            "$ref": "#/$defs/sites"
          },
          "flowSteps": {
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "flowId",
                "stepId"
              ],
              "properties": {
                "flowId": {
                  "minLength": 1,
                  "type": "string"
                },
                "stepId": {
                  "minLength": 1,
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "capabilityId",
          "p2Status",
          "diagnostics"
        ],
        "properties": {
          "capabilityId": {
            "minLength": 1,
            "type": "string"
          },
          "p2Status": {
            "enum": [
              "not-applicable",
              "proven",
              "unprovable"
            ]
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "code",
                "detail"
              ],
              "properties": {
                "code": {
                  "minLength": 1,
                  "type": "string"
                },
                "flowId": {
                  "minLength": 1,
                  "type": "string"
                },
                "stepId": {
                  "minLength": 1,
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sites": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "line": {
            "minimum": 1,
            "type": "integer"
          }
        }
      }
    }
  }
}
