{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archcontext.dev/schemas/runtime/structural-observation-payload.schema.json",
  "title": "StructuralObservationPayloadV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessmentDigest",
    "kind",
    "affectedNodeIds",
    "baselineSnapshotDigest",
    "derivedOutcomes",
    "metrics",
    "signalIds",
    "evidence"
  ],
  "properties": {
    "assessmentDigest": {
      "$ref": "#/$defs/sha256"
    },
    "kind": {
      "enum": [
        "co-change-coupling",
        "cycle",
        "direction-violation",
        "entrypoint-bypass",
        "evidence-gap",
        "low-cohesion-god-file",
        "ownership-ambiguous",
        "residual-cycle",
        "undeclared-footprint",
        "unowned-paths",
        "unstable-dependency"
      ]
    },
    "affectedNodeIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "baselineSnapshotDigest": {
      "$ref": "#/$defs/sha256"
    },
    "derivedOutcomes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/targetOutcome"
      }
    },
    "metrics": {
      "$ref": "#/$defs/observationMetrics"
    },
    "signalIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "$ref": "#/$defs/observationEvidence"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "co-change-coupling"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "kind": {
                "const": "co-change-coupling"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "cycle"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "kind": {
                "const": "cycle"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "direction-violation"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "kind": {
                "const": "direction-violation"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "entrypoint-bypass"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "kind": {
                "const": "entrypoint-bypass"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "evidence-gap"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "kind": {
                "const": "evidence-gap"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "low-cohesion-god-file"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "kind": {
                "const": "low-cohesion-god-file"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ownership-ambiguous"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "kind": {
                "const": "ownership-ambiguous"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "residual-cycle"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "kind": {
                "const": "residual-cycle"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "undeclared-footprint"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "kind": {
                "const": "undeclared-footprint"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "unstable-dependency"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "kind": {
                "const": "unstable-dependency"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "unowned-paths"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "kind": {
                "const": "unowned-paths"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "repoRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!(?:.*/)?\\.\\.(?:/|$)).+$"
    },
    "evidenceLine": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "evidenceSpecifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "evidenceIdList": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "observationMetrics": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "evidenceImportEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromPath",
        "fromLine",
        "toPath",
        "specifier",
        "fromNodeId",
        "toNodeId"
      ],
      "properties": {
        "fromPath": {
          "$ref": "#/$defs/repoRelativePath"
        },
        "fromLine": {
          "$ref": "#/$defs/evidenceLine"
        },
        "toPath": {
          "$ref": "#/$defs/repoRelativePath"
        },
        "specifier": {
          "$ref": "#/$defs/evidenceSpecifier"
        },
        "fromNodeId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "toNodeId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "evidenceDirectionViolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromPath",
        "fromLine",
        "toPath",
        "specifier",
        "fromNodeId",
        "toNodeId",
        "constraintId"
      ],
      "properties": {
        "fromPath": {
          "$ref": "#/$defs/repoRelativePath"
        },
        "fromLine": {
          "$ref": "#/$defs/evidenceLine"
        },
        "toPath": {
          "$ref": "#/$defs/repoRelativePath"
        },
        "specifier": {
          "$ref": "#/$defs/evidenceSpecifier"
        },
        "fromNodeId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "toNodeId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "constraintId": {
          "type": "string"
        }
      }
    },
    "evidencePath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "candidateOwnerNodeIds",
        "candidateOwnerCount"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoRelativePath"
        },
        "candidateOwnerNodeIds": {
          "$ref": "#/$defs/evidenceIdList"
        },
        "candidateOwnerCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "evidenceUnresolvedImport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromPath",
        "fromLine",
        "specifier"
      ],
      "properties": {
        "fromPath": {
          "$ref": "#/$defs/repoRelativePath"
        },
        "fromLine": {
          "$ref": "#/$defs/evidenceLine"
        },
        "specifier": {
          "$ref": "#/$defs/evidenceSpecifier"
        }
      }
    },
    "observationEvidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "memberNodeIds",
            "directions",
            "edges",
            "totalCount",
            "truncated"
          ],
          "properties": {
            "kind": {
              "const": "cycle"
            },
            "memberNodeIds": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "directions": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "description": "[thin, thick] direction of the pair, each with its import-edge population and sampled count.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "fromNodeId",
                  "toNodeId",
                  "totalCount",
                  "sampledCount"
                ],
                "properties": {
                  "fromNodeId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "toNodeId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "totalCount": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "sampledCount": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "edges": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/evidenceImportEdge"
              }
            },
            "totalCount": {
              "type": "integer",
              "minimum": 0
            },
            "truncated": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "memberNodeIds",
            "edges",
            "totalCount",
            "truncated"
          ],
          "properties": {
            "kind": {
              "const": "residual-cycle"
            },
            "memberNodeIds": {
              "$ref": "#/$defs/evidenceIdList"
            },
            "edges": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/evidenceImportEdge"
              }
            },
            "totalCount": {
              "type": "integer",
              "minimum": 0
            },
            "truncated": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "constraintIds",
            "constraintCount",
            "violations",
            "totalCount",
            "truncated"
          ],
          "properties": {
            "kind": {
              "const": "direction-violation"
            },
            "constraintIds": {
              "$ref": "#/$defs/evidenceIdList"
            },
            "constraintCount": {
              "type": "integer",
              "minimum": 0
            },
            "violations": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/evidenceDirectionViolation"
              }
            },
            "totalCount": {
              "type": "integer",
              "minimum": 0
            },
            "truncated": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "paths",
            "totalCount",
            "truncated"
          ],
          "properties": {
            "kind": {
              "enum": [
                "ownership-ambiguous",
                "undeclared-footprint",
                "unowned-paths"
              ]
            },
            "paths": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/evidencePath"
              }
            },
            "totalCount": {
              "type": "integer",
              "minimum": 0
            },
            "truncated": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "coverage",
            "reasonCodes",
            "unresolvedImports",
            "totalCount",
            "truncated"
          ],
          "properties": {
            "kind": {
              "const": "evidence-gap"
            },
            "coverage": {
              "enum": [
                "complete",
                "partial",
                "unknown"
              ]
            },
            "reasonCodes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "caller-coverage-unknown",
                  "code-facts-import-limit",
                  "code-facts-missing",
                  "code-facts-truncated",
                  "major-change-detected",
                  "multi-node-scope",
                  "node-footprint-undeclared",
                  "ownership-ambiguous",
                  "single-node-scope",
                  "target-unresolved",
                  "unowned-paths"
                ]
              }
            },
            "unresolvedImports": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/evidenceUnresolvedImport"
              }
            },
            "totalCount": {
              "type": "integer",
              "minimum": 0
            },
            "truncated": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "files",
            "totalCount",
            "truncated"
          ],
          "properties": {
            "kind": {
              "const": "low-cohesion-god-file"
            },
            "files": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/evidenceLowCohesionFile"
              }
            },
            "totalCount": {
              "type": "integer",
              "minimum": 0
            },
            "truncated": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "declaredEntrypointPaths",
            "edges",
            "totalCount",
            "truncated"
          ],
          "properties": {
            "kind": {
              "const": "entrypoint-bypass"
            },
            "declaredEntrypointPaths": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/repoRelativePath"
              }
            },
            "edges": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/evidenceImportEdge"
              }
            },
            "totalCount": {
              "type": "integer",
              "minimum": 0
            },
            "truncated": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "sourceFanIn",
            "sourceInstability",
            "targets",
            "totalCount",
            "truncated"
          ],
          "properties": {
            "kind": {
              "const": "unstable-dependency"
            },
            "sourceFanIn": {
              "type": "integer",
              "minimum": 0
            },
            "sourceInstability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "targets": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/evidenceUnstableTarget"
              }
            },
            "totalCount": {
              "type": "integer",
              "minimum": 0
            },
            "truncated": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "memberNodeIds",
            "coverageStatus",
            "windowLimit",
            "observedCommitCount",
            "pairs",
            "totalCount",
            "truncated"
          ],
          "properties": {
            "kind": {
              "const": "co-change-coupling"
            },
            "memberNodeIds": {
              "$ref": "#/$defs/evidenceIdList"
            },
            "coverageStatus": {
              "enum": [
                "complete",
                "shallow",
                "insufficient-history",
                "unavailable"
              ]
            },
            "windowLimit": {
              "type": "integer",
              "minimum": 1
            },
            "observedCommitCount": {
              "type": "integer",
              "minimum": 0
            },
            "pairs": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/evidenceCoChangePair"
              }
            },
            "totalCount": {
              "type": "integer",
              "minimum": 0
            },
            "truncated": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "targetOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcomeId",
        "metric",
        "subjectSelectorId",
        "nodeId",
        "operator",
        "value",
        "required"
      ],
      "properties": {
        "outcomeId": {
          "type": "string"
        },
        "metric": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "subjectSelectorId": {
          "type": "string"
        },
        "nodeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "memberNodeIds": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Present exactly for moduleDependencies.* metrics: the pair ends or the residual cycle members, sorted."
        },
        "operator": {
          "enum": [
            "absent",
            "equals",
            "greater_than",
            "less_than",
            "present"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "required": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "operator": {
            "enum": [
              "absent",
              "present"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "value": {
            "type": "number"
          }
        }
      }
    },
    "evidenceLowCohesionCluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbols",
        "startLine",
        "endLine",
        "intraClusterEdges",
        "crossClusterEdges"
      ],
      "properties": {
        "symbols": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "intraClusterEdges": {
          "type": "integer",
          "minimum": 0
        },
        "crossClusterEdges": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "evidenceLowCohesionFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "lineCount",
        "topLevelSymbolCount",
        "clusterCount",
        "clusters"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoRelativePath"
        },
        "lineCount": {
          "type": "integer",
          "minimum": 0
        },
        "topLevelSymbolCount": {
          "type": "integer",
          "minimum": 0
        },
        "clusterCount": {
          "type": "integer",
          "minimum": 0
        },
        "clusters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceLowCohesionCluster"
          }
        }
      }
    },
    "evidenceUnstableTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetNodeId",
        "targetInstability",
        "delta",
        "edgeCount"
      ],
      "properties": {
        "targetNodeId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "targetInstability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "delta": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "edgeCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evidenceCoChangePair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pathA",
        "pathB",
        "coChangeCount",
        "jaccard"
      ],
      "properties": {
        "pathA": {
          "$ref": "#/$defs/repoRelativePath"
        },
        "pathB": {
          "$ref": "#/$defs/repoRelativePath"
        },
        "coChangeCount": {
          "type": "integer",
          "minimum": 1
        },
        "jaccard": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
