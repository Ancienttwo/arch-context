{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archcontext.dev/schemas/runtime/refactor-scan-v2.schema.json",
  "title": "RefactorScanV2",
  "description": "v2 Stage 5 deterministic refactor radar output for `archctx scan --json` (#643).",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "scope",
    "headSha",
    "snapshotDigest",
    "coverage",
    "findings",
    "suppressed"
  ],
  "properties": {
    "schemaVersion": {
      "const": "archcontext.refactor-scan/v2"
    },
    "scope": {
      "oneOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "repository"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "nodeId"
          ],
          "properties": {
            "kind": {
              "const": "node"
            },
            "nodeId": {
              "minLength": 1,
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "paths"
          ],
          "properties": {
            "kind": {
              "const": "paths"
            },
            "paths": {
              "uniqueItems": true,
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "anyOf": [
                    {
                      "pattern": "^/"
                    },
                    {
                      "pattern": "/$"
                    },
                    {
                      "pattern": "//"
                    },
                    {
                      "pattern": "\\\\"
                    },
                    {
                      "pattern": "^[A-Za-z]:"
                    },
                    {
                      "pattern": "[\\u0000-\\u001f\\u007f]"
                    },
                    {
                      "pattern": "(^|/)\\.\\.?(/|$)"
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "headSha": {
      "pattern": "^[a-f0-9]{40}$",
      "type": "string"
    },
    "snapshotDigest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "importNodeLimit": {
      "minimum": 1,
      "type": "integer"
    },
    "coverage": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "imports",
        "gitHistory",
        "reasonCodes"
      ],
      "properties": {
        "imports": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "gitHistory": {
          "type": "string",
          "enum": [
            "complete",
            "shallow",
            "unavailable"
          ]
        },
        "reasonCodes": {
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxLength": 1024,
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "recommendationId",
          "fingerprint",
          "detector",
          "severity",
          "blocking",
          "capabilityId",
          "affectedNodeIds",
          "affectedPaths",
          "killList",
          "metrics",
          "evidence"
        ],
        "properties": {
          "recommendationId": {
            "pattern": "^recommendation\\.[a-f0-9]{16}$",
            "type": "string"
          },
          "fingerprint": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "detector": {
            "type": "string",
            "enum": [
              "file-cycle",
              "component-cycle",
              "god-file",
              "low-cohesion-god-file",
              "entrypoint-bypass",
              "undeclared-dependency",
              "purity-violation",
              "dead-public-export",
              "unstable-dependency",
              "shotgun-surgery-hotspot",
              "co-change-coupling"
            ]
          },
          "severity": {
            "enum": [
              "notice",
              "warning",
              "error",
              "critical"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "capabilityId": {
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          },
          "affectedNodeIds": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "minLength": 1,
              "type": "string"
            }
          },
          "affectedPaths": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "not": {
                "anyOf": [
                  {
                    "pattern": "^/"
                  },
                  {
                    "pattern": "/$"
                  },
                  {
                    "pattern": "//"
                  },
                  {
                    "pattern": "\\\\"
                  },
                  {
                    "pattern": "^[A-Za-z]:"
                  },
                  {
                    "pattern": "[\\u0000-\\u001f\\u007f]"
                  },
                  {
                    "pattern": "(^|/)\\.\\.?(/|$)"
                  }
                ]
              }
            }
          },
          "killList": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "kind",
                    "target",
                    "required"
                  ],
                  "properties": {
                    "kind": {
                      "const": "path"
                    },
                    "target": {
                      "type": "string",
                      "minLength": 1,
                      "not": {
                        "anyOf": [
                          {
                            "pattern": "^/"
                          },
                          {
                            "pattern": "/$"
                          },
                          {
                            "pattern": "//"
                          },
                          {
                            "pattern": "\\\\"
                          },
                          {
                            "pattern": "^[A-Za-z]:"
                          },
                          {
                            "pattern": "[\\u0000-\\u001f\\u007f]"
                          },
                          {
                            "pattern": "(^|/)\\.\\.?(/|$)"
                          }
                        ]
                      }
                    },
                    "required": {
                      "type": "boolean"
                    }
                  }
                },
                {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "kind",
                    "target",
                    "required"
                  ],
                  "properties": {
                    "kind": {
                      "const": "relation"
                    },
                    "target": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "required": {
                      "type": "boolean"
                    }
                  }
                },
                {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "kind",
                    "target",
                    "required"
                  ],
                  "properties": {
                    "kind": {
                      "const": "symbol"
                    },
                    "target": {
                      "pattern": "^(?![A-Za-z]:)(?!\\.\\.?(?:/|#))[^/#\\s\\\\\\u0000-\\u001f\\u007f]+(?:/(?!\\.\\.?(?:/|#))[^/#\\s\\\\\\u0000-\\u001f\\u007f]+)*#[^#\\s\\u0000-\\u001f\\u007f]+$",
                      "type": "string"
                    },
                    "required": {
                      "type": "boolean"
                    }
                  }
                }
              ]
            }
          },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "evidence": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "summary"
            ],
            "properties": {
              "summary": {
                "minLength": 1,
                "maxLength": 1024,
                "type": "string"
              },
              "coChangeSupport": {
                "minimum": 0,
                "type": "integer"
              },
              "coChangeCoverageOk": {
                "type": "boolean"
              },
              "thinDirectionEdgeCount": {
                "minimum": 0,
                "type": "integer"
              },
              "sccSize": {
                "minimum": 0,
                "type": "integer"
              },
              "instabilitySource": {
                "minimum": 0,
                "maximum": 1,
                "type": "number"
              },
              "instabilityTarget": {
                "minimum": 0,
                "maximum": 1,
                "type": "number"
              },
              "testCallerCoverage": {
                "minimum": 0,
                "maximum": 1,
                "type": [
                  "number",
                  "null"
                ]
              },
              "lcomScore": {
                "minimum": 0,
                "type": "number"
              },
              "splitClusterCount": {
                "minimum": 0,
                "type": "integer"
              },
              "observation": {
                "$ref": "#/$defs/observationEvidence"
              }
            }
          }
        }
      }
    },
    "suppressed": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "recommendationId",
          "detector",
          "decisionStatus",
          "reason"
        ],
        "properties": {
          "recommendationId": {
            "pattern": "^recommendation\\.[a-f0-9]{16}$",
            "type": "string"
          },
          "detector": {
            "type": "string",
            "enum": [
              "file-cycle",
              "component-cycle",
              "god-file",
              "low-cohesion-god-file",
              "entrypoint-bypass",
              "undeclared-dependency",
              "purity-violation",
              "dead-public-export",
              "unstable-dependency",
              "shotgun-surgery-hotspot",
              "co-change-coupling"
            ]
          },
          "decisionStatus": {
            "type": "string",
            "enum": [
              "deferred",
              "rejected",
              "waived",
              "resolved"
            ]
          },
          "reason": {
            "minLength": 1,
            "maxLength": 1024,
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "evidenceImportEdge": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "fromPath",
        "fromLine",
        "toPath",
        "specifier",
        "fromNodeId",
        "toNodeId"
      ],
      "properties": {
        "fromPath": {
          "type": "string",
          "minLength": 1,
          "not": {
            "anyOf": [
              {
                "pattern": "^/"
              },
              {
                "pattern": "/$"
              },
              {
                "pattern": "//"
              },
              {
                "pattern": "\\\\"
              },
              {
                "pattern": "^[A-Za-z]:"
              },
              {
                "pattern": "[\\u0000-\\u001f\\u007f]"
              },
              {
                "pattern": "(^|/)\\.\\.?(/|$)"
              }
            ]
          }
        },
        "fromLine": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "toPath": {
          "type": "string",
          "minLength": 1,
          "not": {
            "anyOf": [
              {
                "pattern": "^/"
              },
              {
                "pattern": "/$"
              },
              {
                "pattern": "//"
              },
              {
                "pattern": "\\\\"
              },
              {
                "pattern": "^[A-Za-z]:"
              },
              {
                "pattern": "[\\u0000-\\u001f\\u007f]"
              },
              {
                "pattern": "(^|/)\\.\\.?(/|$)"
              }
            ]
          }
        },
        "specifier": {
          "minLength": 1,
          "type": "string"
        },
        "fromNodeId": {
          "minLength": 1,
          "type": "string"
        },
        "toNodeId": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "evidencePairDirection": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "fromNodeId",
        "toNodeId",
        "totalCount",
        "sampledCount"
      ],
      "properties": {
        "fromNodeId": {
          "minLength": 1,
          "type": "string"
        },
        "toNodeId": {
          "minLength": 1,
          "type": "string"
        },
        "totalCount": {
          "minimum": 0,
          "type": "integer"
        },
        "sampledCount": {
          "minimum": 0,
          "type": "integer"
        }
      }
    },
    "evidenceDirectionViolation": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "constraintId",
        "fromPath",
        "fromLine",
        "toPath",
        "specifier",
        "fromNodeId",
        "toNodeId"
      ],
      "properties": {
        "constraintId": {
          "minLength": 1,
          "type": "string"
        },
        "fromPath": {
          "type": "string",
          "minLength": 1,
          "not": {
            "anyOf": [
              {
                "pattern": "^/"
              },
              {
                "pattern": "/$"
              },
              {
                "pattern": "//"
              },
              {
                "pattern": "\\\\"
              },
              {
                "pattern": "^[A-Za-z]:"
              },
              {
                "pattern": "[\\u0000-\\u001f\\u007f]"
              },
              {
                "pattern": "(^|/)\\.\\.?(/|$)"
              }
            ]
          }
        },
        "fromLine": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "toPath": {
          "type": "string",
          "minLength": 1,
          "not": {
            "anyOf": [
              {
                "pattern": "^/"
              },
              {
                "pattern": "/$"
              },
              {
                "pattern": "//"
              },
              {
                "pattern": "\\\\"
              },
              {
                "pattern": "^[A-Za-z]:"
              },
              {
                "pattern": "[\\u0000-\\u001f\\u007f]"
              },
              {
                "pattern": "(^|/)\\.\\.?(/|$)"
              }
            ]
          }
        },
        "specifier": {
          "minLength": 1,
          "type": "string"
        },
        "fromNodeId": {
          "minLength": 1,
          "type": "string"
        },
        "toNodeId": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "evidencePathEntry": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "path",
        "candidateOwnerNodeIds",
        "candidateOwnerCount"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "not": {
            "anyOf": [
              {
                "pattern": "^/"
              },
              {
                "pattern": "/$"
              },
              {
                "pattern": "//"
              },
              {
                "pattern": "\\\\"
              },
              {
                "pattern": "^[A-Za-z]:"
              },
              {
                "pattern": "[\\u0000-\\u001f\\u007f]"
              },
              {
                "pattern": "(^|/)\\.\\.?(/|$)"
              }
            ]
          }
        },
        "candidateOwnerNodeIds": {
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minLength": 1,
            "type": "string"
          }
        },
        "candidateOwnerCount": {
          "minimum": 0,
          "type": "integer"
        }
      }
    },
    "evidenceUnresolvedImport": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "fromPath",
        "fromLine",
        "specifier"
      ],
      "properties": {
        "fromPath": {
          "type": "string",
          "minLength": 1,
          "not": {
            "anyOf": [
              {
                "pattern": "^/"
              },
              {
                "pattern": "/$"
              },
              {
                "pattern": "//"
              },
              {
                "pattern": "\\\\"
              },
              {
                "pattern": "^[A-Za-z]:"
              },
              {
                "pattern": "[\\u0000-\\u001f\\u007f]"
              },
              {
                "pattern": "(^|/)\\.\\.?(/|$)"
              }
            ]
          }
        },
        "fromLine": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "specifier": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "evidenceLowCohesionCluster": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "symbols",
        "startLine",
        "endLine",
        "intraClusterEdges",
        "crossClusterEdges"
      ],
      "properties": {
        "symbols": {
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minLength": 1,
            "type": "string"
          }
        },
        "startLine": {
          "minimum": 1,
          "type": "integer"
        },
        "endLine": {
          "minimum": 1,
          "type": "integer"
        },
        "intraClusterEdges": {
          "minimum": 0,
          "type": "integer"
        },
        "crossClusterEdges": {
          "minimum": 0,
          "type": "integer"
        }
      }
    },
    "evidenceLowCohesionFile": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "path",
        "lineCount",
        "topLevelSymbolCount",
        "clusterCount",
        "clusters"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "not": {
            "anyOf": [
              {
                "pattern": "^/"
              },
              {
                "pattern": "/$"
              },
              {
                "pattern": "//"
              },
              {
                "pattern": "\\\\"
              },
              {
                "pattern": "^[A-Za-z]:"
              },
              {
                "pattern": "[\\u0000-\\u001f\\u007f]"
              },
              {
                "pattern": "(^|/)\\.\\.?(/|$)"
              }
            ]
          }
        },
        "lineCount": {
          "minimum": 0,
          "type": "integer"
        },
        "topLevelSymbolCount": {
          "minimum": 0,
          "type": "integer"
        },
        "clusterCount": {
          "minimum": 0,
          "type": "integer"
        },
        "clusters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceLowCohesionCluster"
          }
        }
      }
    },
    "evidenceUnstableTarget": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "targetNodeId",
        "targetInstability",
        "delta",
        "edgeCount"
      ],
      "properties": {
        "targetNodeId": {
          "minLength": 1,
          "type": "string"
        },
        "targetInstability": {
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        },
        "delta": {
          "minimum": -1,
          "maximum": 1,
          "type": "number"
        },
        "edgeCount": {
          "minimum": 1,
          "type": "integer"
        }
      }
    },
    "evidenceCoChangePair": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "pathA",
        "pathB",
        "coChangeCount",
        "jaccard"
      ],
      "properties": {
        "pathA": {
          "type": "string",
          "minLength": 1,
          "not": {
            "anyOf": [
              {
                "pattern": "^/"
              },
              {
                "pattern": "/$"
              },
              {
                "pattern": "//"
              },
              {
                "pattern": "\\\\"
              },
              {
                "pattern": "^[A-Za-z]:"
              },
              {
                "pattern": "[\\u0000-\\u001f\\u007f]"
              },
              {
                "pattern": "(^|/)\\.\\.?(/|$)"
              }
            ]
          }
        },
        "pathB": {
          "type": "string",
          "minLength": 1,
          "not": {
            "anyOf": [
              {
                "pattern": "^/"
              },
              {
                "pattern": "/$"
              },
              {
                "pattern": "//"
              },
              {
                "pattern": "\\\\"
              },
              {
                "pattern": "^[A-Za-z]:"
              },
              {
                "pattern": "[\\u0000-\\u001f\\u007f]"
              },
              {
                "pattern": "(^|/)\\.\\.?(/|$)"
              }
            ]
          }
        },
        "coChangeCount": {
          "minimum": 1,
          "type": "integer"
        },
        "jaccard": {
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        }
      }
    },
    "observationEvidence": {
      "oneOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "memberNodeIds",
            "directions",
            "edges",
            "totalCount",
            "truncated"
          ],
          "properties": {
            "kind": {
              "const": "cycle"
            },
            "memberNodeIds": {
              "uniqueItems": true,
              "type": "array",
              "items": {
                "minLength": 1,
                "type": "string"
              }
            },
            "directions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/evidencePairDirection"
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/evidenceImportEdge"
              }
            },
            "totalCount": {
              "minimum": 0,
              "type": "integer"
            },
            "truncated": {
              "type": "boolean"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "memberNodeIds",
            "edges",
            "totalCount",
            "truncated"
          ],
          "properties": {
            "kind": {
              "const": "residual-cycle"
            },
            "memberNodeIds": {
              "uniqueItems": true,
              "type": "array",
              "items": {
                "minLength": 1,
                "type": "string"
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/evidenceImportEdge"
              }
            },
            "totalCount": {
              "minimum": 0,
              "type": "integer"
            },
            "truncated": {
              "type": "boolean"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "constraintIds",
            "constraintCount",
            "violations",
            "totalCount",
            "truncated"
          ],
          "properties": {
            "kind": {
              "const": "direction-violation"
            },
            "constraintIds": {
              "uniqueItems": true,
              "type": "array",
              "items": {
                "minLength": 1,
                "type": "string"
              }
            },
            "constraintCount": {
              "minimum": 0,
              "type": "integer"
            },
            "violations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/evidenceDirectionViolation"
              }
            },
            "totalCount": {
              "minimum": 0,
              "type": "integer"
            },
            "truncated": {
              "type": "boolean"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "paths",
            "totalCount",
            "truncated"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
