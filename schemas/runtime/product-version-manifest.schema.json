{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archcontext.dev/schemas/runtime/product-version-manifest.schema.json",
  "title": "ProductVersionManifest",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "product",
    "packageManager",
    "engines",
    "surfaces",
    "schemas",
    "runtime"
  ],
  "properties": {
    "schemaVersion": {
      "const": "archcontext.product-version-manifest/v1"
    },
    "product": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "version",
        "distribution"
      ],
      "properties": {
        "name": {
          "const": "archctx"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "distribution": {
          "enum": [
            "one-package"
          ]
        }
      }
    },
    "packageManager": {
      "minLength": 1,
      "type": "string"
    },
    "engines": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "node"
      ],
      "properties": {
        "node": {
          "const": ">=22.22 <27"
        }
      }
    },
    "surfaces": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "cli",
        "daemon"
      ],
      "properties": {
        "cli": {
          "$ref": "#/$defs/surface"
        },
        "daemon": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "packageName",
            "version",
            "entrypoint",
            "rpcSchemaVersion"
          ],
          "properties": {
            "packageName": {
              "minLength": 1,
              "type": "string"
            },
            "version": {
              "$ref": "#/$defs/semver"
            },
            "entrypoint": {
              "minLength": 1,
              "type": "string"
            },
            "rpcSchemaVersion": {
              "const": "archcontext.runtime-rpc/v2"
            }
          }
        }
      }
    },
    "schemas": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schemaSetVersion",
        "contractsPackageVersion"
      ],
      "properties": {
        "schemaSetVersion": {
          "minLength": 1,
          "type": "string"
        },
        "contractsPackageVersion": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "runtime": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "localRpc",
        "sqliteMigrations",
        "codeGraph"
      ],
      "properties": {
        "localRpc": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "schemaVersion",
            "protocol"
          ],
          "properties": {
            "schemaVersion": {
              "const": "archcontext.runtime-rpc/v2"
            },
            "protocol": {
              "enum": [
                "http-loopback"
              ]
            }
          }
        },
        "sqliteMigrations": {
          "minLength": 1,
          "type": "string"
        },
        "codeGraph": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "packageName",
            "requiredVersion",
            "adapter"
          ],
          "properties": {
            "packageName": {
              "const": "@colbymchenry/codegraph"
            },
            "requiredVersion": {
              "minLength": 1,
              "type": "string"
            },
            "adapter": {
              "enum": [
                "codegraph-cli"
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "surface": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "packageName",
        "version",
        "entrypoint"
      ],
      "properties": {
        "packageName": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "entrypoint": {
          "minLength": 1,
          "type": "string"
        }
      }
    }
  }
}
