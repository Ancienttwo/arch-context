{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archcontext.dev/schemas/runtime/ref-impact-batch-request.schema.json",
  "title": "RefImpactBatchRequestV1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "archcontext.ref-impact-batch-request/v1"
    },
    "items": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "paths"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "paths": {
            "type": "array",
            "items": {
              "pattern": "^(?!/)(?![\\s\\S]*(?:^|/)\\.\\.(?:/|(?![\\s\\S])))[^\\\\\u0000]+$",
              "type": "string"
            }
          }
        }
      }
    }
  }
}
