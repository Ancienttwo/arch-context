{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archcontext.dev/schemas/runtime/sync-check.schema.json",
  "title": "SyncCheckOutputV1",
  "description": "Read-only projection freshness check returned by `archctx sync --check --json`.",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "check",
    "fresh",
    "profile",
    "includeInstructions",
    "modelDigest",
    "pendingGeneratedPaths"
  ],
  "properties": {
    "schemaVersion": {
      "const": "archcontext.sync-check/v1"
    },
    "check": {
      "const": true
    },
    "fresh": {
      "type": "boolean"
    },
    "profile": {
      "type": "string",
      "enum": [
        "default",
        "repo-harness/v1"
      ]
    },
    "includeInstructions": {
      "type": "boolean"
    },
    "modelDigest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "pendingGeneratedPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {
          "anyOf": [
            {
              "pattern": "^/"
            },
            {
              "pattern": "\\\\"
            },
            {
              "pattern": "(^|/)\\.\\.(/|$)"
            }
          ]
        }
      }
    },
    "drift": {
      "type": "object"
    }
  }
}
