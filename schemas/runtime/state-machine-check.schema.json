{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archcontext.dev/schemas/runtime/state-machine-check.schema.json",
  "title": "StateMachineCheckV1",
  "description": "The data of `archctx state-machines check`: for every declared state machine, the size of its reachable global state space, the result of each declared rule, the built-in breaks and the status of each code anchor. The same model gives the same bytes.",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "machines"
  ],
  "properties": {
    "schemaVersion": {
      "const": "archcontext.state-machine-check/v1"
    },
    "machines": {
      "description": "Sorted by machine id.",
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "capabilityId",
          "reachableStates",
          "transitions",
          "rules",
          "breaks",
          "anchors"
        ],
        "properties": {
          "id": {
            "pattern": "^state-machine\\.[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)*$",
            "type": "string"
          },
          "capabilityId": {
            "pattern": "^capability\\.[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)*$",
            "type": "string"
          },
          "reachableStates": {
            "minimum": 1,
            "type": "integer"
          },
          "transitions": {
            "minimum": 0,
            "description": "Pairs of a reachable global state and an enabled step that changes it.",
            "type": "integer"
          },
          "rules": {
            "description": "In declaration order.",
            "type": "array",
            "items": {
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "enum": [
                          "broken",
                          "finding-open"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "state",
                      "path"
                    ],
                    "not": {
                      "required": [
                        "protectedBy"
                      ]
                    }
                  },
                  "else": {
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "state"
                          ]
                        },
                        {
                          "required": [
                            "path"
                          ]
                        }
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "status": {
                        "enum": [
                          "finding-open",
                          "finding-resolved"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "tracking"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "tracking"
                      ]
                    }
                  }
                }
              ],
              "type": "object",
              "required": [
                "id",
                "kind",
                "status"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/localId"
                },
                "kind": {
                  "enum": [
                    "never",
                    "final"
                  ]
                },
                "status": {
                  "enum": [
                    "holds",
                    "broken",
                    "finding-open",
                    "finding-resolved"
                  ]
                },
                "tracking": {
                  "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*(?::[0-9]{1,5})?(?:[/?#][^\\s]*)?$",
                  "type": "string"
                },
                "state": {
                  "$ref": "#/$defs/globalState"
                },
                "path": {
                  "$ref": "#/$defs/path"
                },
                "protectedBy": {
                  "description": "The guards whose removal breaks this holding rule, in declaration order of the guards.",
                  "type": "array",
                  "items": {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "event",
                      "step",
                      "region"
                    ],
                    "properties": {
                      "event": {
                        "$ref": "#/$defs/localId"
                      },
                      "step": {
                        "$ref": "#/$defs/stepIndex"
                      },
                      "region": {
                        "$ref": "#/$defs/localId"
                      }
                    }
                  }
                }
              }
            }
          },
          "breaks": {
            "description": "Every unreachable state, then every dead step, each in declaration order, then at most one deadlock.",
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "kind",
                    "region",
                    "state"
                  ],
                  "properties": {
                    "kind": {
                      "const": "unreachable-state"
                    },
                    "region": {
                      "$ref": "#/$defs/localId"
                    },
                    "state": {
                      "$ref": "#/$defs/localId"
                    }
                  }
                },
                {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "kind",
                    "event",
                    "step"
                  ],
                  "properties": {
                    "kind": {
                      "const": "dead-step"
                    },
                    "event": {
                      "$ref": "#/$defs/localId"
                    },
                    "step": {
                      "$ref": "#/$defs/stepIndex"
                    }
                  }
                },
                {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "kind",
                    "state",
                    "path",
                    "count"
                  ],
                  "properties": {
                    "kind": {
                      "const": "deadlock"
                    },
                    "state": {
                      "$ref": "#/$defs/globalState"
                    },
                    "path": {
                      "$ref": "#/$defs/path"
                    },
                    "count": {
                      "minimum": 1,
                      "description": "The number of deadlocked reachable global states.",
                      "type": "integer"
                    }
                  }
                }
              ]
            }
          },
          "anchors": {
            "description": "Every code source of a region or an event, regions first, then events, each in declaration order, with its status against the current file.",
            "type": "array",
            "items": {
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "required": [
                      "symbol",
                      "digest"
                    ]
                  },
                  "then": {
                    "required": [
                      "callees"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "callees"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "status": {
                        "enum": [
                          "anchor-unconfirmed",
                          "anchor-changed",
                          "confirmed"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "digest"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "digest"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "unchecked"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "reason",
                      "symbol"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "reason"
                      ]
                    }
                  }
                }
              ],
              "type": "object",
              "required": [
                "owner",
                "ownerId",
                "path",
                "status"
              ],
              "properties": {
                "owner": {
                  "enum": [
                    "region",
                    "event"
                  ]
                },
                "ownerId": {
                  "$ref": "#/$defs/localId"
                },
                "path": {
                  "minLength": 1,
                  "type": "string"
                },
                "symbol": {
                  "minLength": 1,
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "anchor-missing-path",
                    "anchor-language-unsupported",
                    "anchor-missing-symbol",
                    "anchor-ambiguous-symbol",
                    "unchecked",
                    "anchor-unconfirmed",
                    "anchor-changed",
                    "confirmed"
                  ]
                },
                "digest": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "description": "The file content, or a JSON array of the lines of the one matching declaration and of each direct callee, with CRLF read as LF.",
                  "type": "string"
                },
                "callees": {
                  "description": "The direct callees that the digest of a symbol anchor covers, in digest order.",
                  "type": "array",
                  "items": {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "path",
                      "qualifiedName"
                    ],
                    "properties": {
                      "path": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "qualifiedName": {
                        "minLength": 1,
                        "type": "string"
                      }
                    }
                  }
                },
                "reason": {
                  "description": "Why the symbol reader is unavailable, or that the index does not hold the current content of the anchor's file or of a callee's file.",
                  "enum": [
                    "index-missing",
                    "index-open-failed",
                    "index-stale"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "localId": {
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "type": "string"
    },
    "stepIndex": {
      "minimum": 1,
      "description": "The 1-based index of the step in its event.",
      "type": "integer"
    },
    "globalState": {
      "description": "One state per region, keyed by region id in declaration order.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/localId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/localId"
      }
    },
    "path": {
      "description": "The shortest sequence of fired steps from the initial global state.",
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event",
          "step"
        ],
        "properties": {
          "event": {
            "$ref": "#/$defs/localId"
          },
          "step": {
            "$ref": "#/$defs/stepIndex"
          }
        }
      }
    }
  }
}
