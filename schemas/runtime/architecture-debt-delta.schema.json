{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archctx.repoharness.com/schemas/runtime/architecture-debt-delta.schema.json",
  "title": "ArchitectureDebtDeltaReportV1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "head",
    "base",
    "introduced",
    "resolvedIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": "archcontext.architecture-debt-delta/v1"
    },
    "head": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "sha",
        "debt"
      ],
      "properties": {
        "sha": {
          "$ref": "#/$defs/commitSha"
        },
        "debt": {
          "$ref": "architecture-debt.schema.json"
        }
      }
    },
    "base": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "ref",
        "sha",
        "debtDigest",
        "coverage",
        "coverageReasonCodes"
      ],
      "properties": {
        "ref": {
          "minLength": 1,
          "type": "string"
        },
        "sha": {
          "$ref": "#/$defs/commitSha"
        },
        "debtDigest": {
          "$ref": "architecture-debt.schema.json#/properties/digest"
        },
        "coverage": {
          "$ref": "architecture-debt.schema.json#/properties/coverage"
        },
        "coverageReasonCodes": {
          "$ref": "architecture-debt.schema.json#/properties/coverageReasonCodes"
        }
      }
    },
    "introduced": {
      "description": "Items ordered by item ID.",
      "uniqueItems": true,
      "type": "array",
      "items": {
        "$ref": "architecture-debt.schema.json#/properties/items/items"
      }
    },
    "resolvedIds": {
      "description": "Resolved item IDs in ascending order.",
      "uniqueItems": true,
      "type": "array",
      "items": {
        "$ref": "architecture-debt.schema.json#/properties/items/items/properties/id"
      }
    }
  },
  "$defs": {
    "commitSha": {
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
      "type": "string"
    }
  }
}
