{
  "name": "archcontext",
  "version": "0.11.4",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/contracts",
    "packages/core",
    "packages/local-runtime",
    "packages/surfaces",
    "packages/cloud"
  ],
  "engines": {
    "node": ">=22.22 <26"
  },
  "dependencies": {
    "@archcontext/surfaces": "workspace:*",
    "@colbymchenry/codegraph": "1.6.2"
  },
  "scripts": {
    "test": "bun test",
    "test:codegraph-selector-node": "node scripts/codegraph-selector-node-integration.mjs",
    "typecheck": "tsc --noEmit",
    "test:contracts": "bun test packages/contracts/test/contracts.test.ts",
    "test:practices": "bun test packages/core/practice-catalog packages/core/practice-engine",
    "test:practice-engine": "bun test packages/core/practice-engine",
    "verify:practices": "bun test packages/core/practice-catalog packages/core/practice-engine && bun packages/surfaces/cli/src/main.ts practices validate --strict && bun packages/surfaces/cli/src/main.ts practices list --json",
    "e2e:local-product-tarball": "node scripts/local-product-tarball-smoke.mjs",
    "e2e:local-no-cloud": "node scripts/local-no-cloud-e2e.mjs",
    "check:production-mock-reachability": "node scripts/production-mock-reachability-audit.mjs",
    "handoff:s2:external": "node scripts/sprint2-external-evidence-handoff.mjs render",
    "readback:s2:external": "node scripts/sprint2-external-evidence-readback.mjs readback --json",
    "readback:s3:hook-egress": "node scripts/practice-hook-egress-readback.mjs readback --evidence docs/verification/practice-hook-egress-readback.json --json",
    "record:s5:context7": "bun scripts/practice-context7-readback.ts run --out docs/verification/practice-context7-readback.json --json",
    "readback:s5:context7": "bun scripts/practice-context7-readback.ts inspect --evidence docs/verification/practice-context7-readback.json --json",
    "record:s5:context7:live": "bun scripts/practice-context7-readback.ts live --out docs/verification/practice-context7-live-readback.json --json",
    "readback:s5:context7:live": "bun scripts/practice-context7-readback.ts inspect-live --evidence docs/verification/practice-context7-live-readback.json --json",
    "record:s6:catalog": "bun scripts/practice-assets-s6-catalog-readback.ts run --out docs/verification/practice-assets-s6-catalog-readback.json --json",
    "readback:s6:catalog": "bun scripts/practice-assets-s6-catalog-readback.ts inspect --evidence docs/verification/practice-assets-s6-catalog-readback.json --json",
    "record:s6:eval": "bun scripts/practice-assets-s6-eval-readback.ts run --out docs/verification/practice-assets-s6-eval-readback.json --json",
    "readback:s6:eval": "bun scripts/practice-assets-s6-eval-readback.ts inspect --evidence docs/verification/practice-assets-s6-eval-readback.json --json",
    "record:s6:runtime": "bun scripts/practice-assets-s6-runtime-readback.ts run --out docs/verification/practice-assets-s6-runtime-readback.json --json",
    "readback:s6:runtime": "bun scripts/practice-assets-s6-runtime-readback.ts inspect --evidence docs/verification/practice-assets-s6-runtime-readback.json --json",
    "readback:fg6:local-no-cloud": "bun scripts/fg6-local-no-cloud-readback.ts run --out docs/verification/fg6-local-no-cloud-readback.json --json",
    "readback:fg6:npm-release-dry-run": "bun scripts/fg6-npm-release-dry-run.ts run --out docs/verification/fg6-npm-release-dry-run.json --json",
    "verify:architecture-mermaid": "node scripts/verify-architecture-mermaid.mjs",
    "check:architecture-mermaid": "node scripts/check-architecture-mermaid.mjs",
    "verify:axr3-semantic-pilot": "bun scripts/architecture-projection-axr3-semantic-pilot-readback.ts",
    "readback:fg6:local-product-tarball": "node scripts/local-product-tarball-smoke.mjs --out docs/verification/fg6-local-product-tarball-smoke.json",
    "preflight:contracts:npm": "node scripts/publish-archcontext-contracts.mjs preflight",
    "publish:contracts": "node scripts/publish-archcontext-contracts.mjs publish --confirm-publish",
    "preflight:archctx:npm": "node scripts/publish-archctx.mjs",
    "publish:archctx": "node scripts/publish-archctx.mjs --confirm-publish",
    "apply:model-proposal": "bun scripts/apply-model-proposal.ts",
    "readback:release": "bun scripts/release-provenance-readback.ts run --out docs/verification/release-provenance-readback.json --report docs/verification/release-provenance.md --json",
    "record:al10:rollout-workflow": "bun scripts/architecture-ledger-al10-rollout-workflow-readback.ts run --out docs/verification/architecture-ledger-al10-rollout-workflow-readback.json --report docs/verification/architecture-ledger-al10-rollout-workflow.md --json",
    "readback:al10:rollout-workflow": "bun scripts/architecture-ledger-al10-rollout-workflow-readback.ts inspect --evidence docs/verification/architecture-ledger-al10-rollout-workflow-readback.json --json",
    "record:al10:hardening": "bun scripts/architecture-ledger-al10-hardening-readback.ts run --out docs/verification/architecture-ledger-al10-hardening-readback.json --report docs/verification/architecture-ledger-al10-hardening.md --json",
    "readback:al10:hardening": "bun scripts/architecture-ledger-al10-hardening-readback.ts inspect --evidence docs/verification/architecture-ledger-al10-hardening-readback.json --json",
    "record:al10:chaos-security": "bun scripts/architecture-ledger-al10-chaos-security-readback.ts run --out docs/verification/architecture-ledger-al10-chaos-security-readback.json --report docs/verification/architecture-ledger-al10-chaos-security.md --json",
    "readback:al10:chaos-security": "bun scripts/architecture-ledger-al10-chaos-security-readback.ts inspect --evidence docs/verification/architecture-ledger-al10-chaos-security-readback.json --json",
    "record:al10:release-packaging": "bun scripts/architecture-ledger-al10-release-packaging-readback.ts run --out docs/verification/architecture-ledger-al10-release-packaging-readback.json --report docs/verification/architecture-ledger-al10-release-packaging.md --json",
    "readback:al10:release-packaging": "bun scripts/architecture-ledger-al10-release-packaging-readback.ts inspect --evidence docs/verification/architecture-ledger-al10-release-packaging-readback.json --json",
    "readback:ga:preflight": "node deploy/scripts/production-ga-readback.mjs preflight --environment production --json",
    "readback:ga": "node deploy/scripts/production-ga-readback.mjs run --environment production --json",
    "verify:explorer": "bun scripts/explorer-view-compiler-readback.mjs --check",
    "record:de5:data-engine": "bun scripts/data-engine-de5-readback.ts run --out docs/verification/data-engine-de5-readback.json --report docs/verification/data-engine-de5-readback.md",
    "readback:de5:data-engine": "bun scripts/data-engine-de5-readback.ts inspect --out docs/verification/data-engine-de5-readback.json",
    "verify": "bun scripts/check-bun-version.mjs && bun run typecheck && node scripts/package-boundary-audit.mjs && node scripts/production-mock-reachability-audit.mjs && bun run verify:architecture-mermaid && bun run check:architecture-mermaid && bun run verify:practices && bun run test:codegraph-selector-node && bun test --timeout 60000 && bun run verify:explorer && node scripts/packaged-cli-smoke.mjs && node scripts/privacy-route-audit.mjs && bun run verify:github-api-contract && node scripts/privacy-packet-capture-audit.mjs docs/security/captures/metadata-only.har.json && node scripts/privacy-capture-manifest.mjs readback && bun run readback:s3:hook-egress && bun run readback:s5:context7 && node scripts/security-scan-manifest.mjs readback && bun evals/run.ts --check",
    "verify:governance": "node scripts/verify-governance.mjs",
    "verify:github-api-contract": "bun run verify:privacy-contract",
    "verify:privacy-contract": "node scripts/github-api-contract-audit.mjs",
    "check:package-boundaries": "node scripts/package-boundary-audit.mjs",
    "eval": "bun evals/run.ts",
    "check:context-files": "repo-harness run check-context-files",
    "check:deploy-sql": "repo-harness run check-deploy-sql-order",
    "verify:pre": "bun scripts/check-bun-version.mjs && bun run typecheck && node scripts/package-boundary-audit.mjs && node scripts/production-mock-reachability-audit.mjs && bun run verify:architecture-mermaid && bun run check:architecture-mermaid && bun run verify:practices && bun run test:codegraph-selector-node",
    "verify:post": "bun run verify:explorer && node scripts/packaged-cli-smoke.mjs && node scripts/privacy-route-audit.mjs && bun run verify:github-api-contract && node scripts/privacy-packet-capture-audit.mjs docs/security/captures/metadata-only.har.json && node scripts/privacy-capture-manifest.mjs readback && bun run readback:s3:hook-egress && bun run readback:s5:context7 && node scripts/security-scan-manifest.mjs readback && bun evals/run.ts --check",
    "verify:node-compat": "bun run test:codegraph-selector-node && node scripts/packaged-cli-smoke.mjs && bun test --timeout 60000 packages/surfaces/cli/test/bundle-entry.test.ts packages/surfaces/mcp-local/test/mcp-wire.test.ts tests/ownership-change-acceptance-recovery.test.ts packages/contracts/test/publishability.test.ts",
    "verify:ci": "node scripts/verify-ci.mjs",
    "check:brain": "repo-harness brain check",
    "sync:brain": "repo-harness brain sync"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "11.16.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@types/node": "^26.0.0",
    "bun-types": "1.4.3",
    "linkedom": "0.18.13",
    "mermaid": "11.16.1",
    "typescript": "^7.0.2"
  }
}
