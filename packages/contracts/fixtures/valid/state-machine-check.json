{
  "schemaVersion": "archcontext.state-machine-check/v1",
  "machines": [
    {
      "id": "state-machine.checkout.order",
      "capabilityId": "capability.checkout",
      "reachableStates": 6,
      "transitions": 5,
      "rules": [
        {
          "id": "paid-before-shipped",
          "kind": "never",
          "status": "broken",
          "state": {
            "order": "shipped",
            "payment": "unpaid"
          },
          "path": [
            {
              "event": "ship",
              "step": 1
            }
          ]
        },
        {
          "id": "closed-order-stays-closed",
          "kind": "final",
          "status": "holds",
          "protectedBy": [
            {
              "event": "ship",
              "step": 1,
              "region": "order"
            },
            {
              "event": "cancel",
              "step": 1,
              "region": "order"
            },
            {
              "event": "cancel",
              "step": 2,
              "region": "order"
            }
          ]
        }
      ],
      "breaks": [],
      "anchors": [
        {
          "owner": "event",
          "ownerId": "capture",
          "path": "src/payment.ts",
          "symbol": "PaymentService.capture",
          "status": "anchor-unconfirmed",
          "digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
        },
        {
          "owner": "event",
          "ownerId": "ship",
          "path": "src/order.ts",
          "symbol": "shipOrder",
          "status": "anchor-unconfirmed",
          "digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222"
        },
        {
          "owner": "event",
          "ownerId": "cancel",
          "path": "src/order.ts",
          "symbol": "cancelOrder",
          "status": "anchor-missing-symbol"
        }
      ]
    }
  ]
}
